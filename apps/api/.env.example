NODE_ENV=development
PORT=4000
APP_NAME=streamvault-vod
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
TRUST_PROXY=1

# MySQL Database
DATABASE_URL="mysql://vod_user:vod_local_pass_change_me@localhost:3306/vod_platform?connection_limit=20&pool_timeout=15"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_pass_change_me
REDIS_DB=0
REDIS_TLS_ENABLED=false

# JWT & Security
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret_for_access_tokens_minimum_32_chars
JWT_REFRESH_SECRET=replace_with_64_byte_hex_secret_for_refresh_tokens_minimum_32_chars
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
JWT_ISSUER=streamvault.api
JWT_AUDIENCE=streamvault.client

# Cookies & CORS
COOKIE_SECRET=replace_with_64_byte_hex_secret_for_cookie_signing_minimum_32_chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_PROTECTION_ENABLED=true

# Login Brute-Force Protection
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900

# S3 Object Storage
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin_change_me
S3_SECRET_ACCESS_KEY=minioadmin_change_me
S3_RAW_UPLOADS_BUCKET=vod-raw-uploads-private
S3_PROCESSED_MEDIA_BUCKET=vod-processed-hls-private
S3_UPLOAD_URL_EXPIRES_SECONDS=3600
MAX_UPLOAD_FILE_SIZE_BYTES=10737418240

# CDN & Playback
CDN_BASE_URL=https://cdn.streamvault.example.com
CDN_SIGNING_ENABLED=false
CDN_KEY_PAIR_ID=K2JCJMDEHXQW5F
CDN_PRIVATE_KEY_BASE64=
PLAYBACK_SESSION_TTL_SECONDS=14400
PLAYBACK_HEARTBEAT_TIMEOUT_SECONDS=120
DEFAULT_MAX_CONCURRENT_STREAMS=2
MAX_DEVICES_PER_ACCOUNT=5

# FFmpeg & Workers
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
WORKER_TRANSCODE_CONCURRENCY=2
WORKER_FFMPEG_THREADS=4
TRANSCODE_TIMEOUT_MS=7200000
TRANSCODE_TEMP_DIR=/tmp/vod-transcode

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_with_real_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_stripe_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:3000/account/billing?status=success
STRIPE_CANCEL_URL=http://localhost:3000/account/billing?status=canceled
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Observability
LOG_LEVEL=info
METRICS_ENABLED=true
SLOW_QUERY_THRESHOLD_MS=500
